# ==============================================================================
# AnonReply — Vercel Environment Variables (.env.example)
# ==============================================================================
# Add these variables under your Vercel Project -> Settings -> Environment Variables.
# Make sure to check ALL THREE environments: [x] Production, [x] Preview, [x] Development.

# ------------------------------------------------------------------------------
# 1. MongoDB Database Connection (REQUIRED)
# ------------------------------------------------------------------------------
# From MongoDB Atlas: Database -> Connect -> Drivers -> Node.js
# Ensure you replace <db_password> and include the database name /anonreply
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/anonreply?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. NextAuth Authentication (REQUIRED)
# ------------------------------------------------------------------------------
# Generate a secure 32+ character key with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-secure-random-32-character-secret-key-here

# The canonical production URL of your Vercel deployment
NEXTAUTH_URL=https://your-project.vercel.app

# ------------------------------------------------------------------------------
# 3. Administrator Team Configuration
# ------------------------------------------------------------------------------
# Initial password for all 5 default umbrella admin seats (admin, moderator1, etc.)
ADMIN_PASSWORD=ChangeMe123!

# Primary Admin Account owner email address
ADMIN_EMAIL=admin@example.com

# Notification inbox: incoming user help requests & live chat requests route here
NOTIFICATION_ROUTING_EMAIL=notifications@example.com

# ------------------------------------------------------------------------------
# 4. Email Delivery via Resend (OPTIONAL - Enables real email notifications)
# ------------------------------------------------------------------------------
# Get your free API key at https://resend.com (Free tier: 3,000 emails/month)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 5. Google OAuth Authentication (OPTIONAL)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
